# Comic Video MCP Server Configuration

# Paths to FFmpeg / FFprobe (optional, auto-detected if not specified)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Output Directory (relative or absolute)
OUTPUT_DIR=output

# Default Video Configuration
DEFAULT_WIDTH=1920
DEFAULT_HEIGHT=1080
DEFAULT_FPS=30

# Default Timing (seconds)
DEFAULT_PANEL_DURATION=5.0
DEFAULT_TRANSITION_DURATION=2.0
DEFAULT_INTRO_DURATION=2.0
DEFAULT_OUTRO_DURATION=2.0

# Camera Movement Preset (educational, gentle, emotional, object_focus, wide)
DEFAULT_PRESET=educational
